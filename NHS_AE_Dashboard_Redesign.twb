          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Attendance YoY</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>2018 vs 2019</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AE_attendances_england_monthly' name='federated.0igv0bj0cmyt2n0zse9t31me8uzt' />
          </datasources>
          <datasource-dependencies datasource='federated.0igv0bj0cmyt2n0zse9t31me8uzt'>
            <column caption='Name Clean' datatype='string' name='[Calculation_1463217077719048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRIM([Name])' />
            </column>
            <column caption='Show 2019 YoY' datatype='boolean' name='[Calculation_1463217409814543]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Total attendances]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1463217077719048]' derivation='None' name='[none:Calculation_1463217077719048:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total attendances]' derivation='Sum' name='[pcdf:sum:Total attendances:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column-instance column='[Calculation_1463217409814543]' derivation='User' name='[usr:Calculation_1463217409814543:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
