    <worksheet name='KPI - Admission vs NHS Average'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='20'>Admission vs NHS Average </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AE_attendances_england_monthly' name='federated.0igv0bj0cmyt2n0zse9t31me8uzt' />
          </datasources>
