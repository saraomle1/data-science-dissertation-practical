            <groupfilter function='level-members' level='[Calculation_1463217077719048]' user:ui-action-filter='[Action1_AB7B79CBE3ED475BA1D1BEB4BF563840]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
