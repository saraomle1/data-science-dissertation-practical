      <table>
        <view>
          <datasources>
            <datasource caption='AE_attendances_england_monthly' name='federated.0igv0bj0cmyt2n0zse9t31me8uzt' />
          </datasources>
          <datasource-dependencies datasource='federated.0igv0bj0cmyt2n0zse9t31me8uzt'>
            <column caption='Name Clean' datatype='string' name='[Calculation_1463217077719048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRIM([Name])' />
            </column>
            <column caption='Average Monthly Attendances' datatype='real' name='[Calculation_1463217095733260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total attendances])&#13;&#10;/&#13;&#10;COUNTD(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='Avg Monthly Attendances Display' datatype='string' name='[Calculation_1463217402929165]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1463217095733260] &gt;= 1000000 THEN&#13;&#10;    STR(ROUND([Calculation_1463217095733260] / 1000000, 1)) + &quot;M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1463217095733260] &gt;= 1000 THEN&#13;&#10;    STR(ROUND([Calculation_1463217095733260] / 1000, 1)) + &quot;K&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(ROUND([Calculation_1463217095733260], 0))&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Total attendances]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1463217077719048]' derivation='None' name='[none:Calculation_1463217077719048:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1463217402929165]' derivation='User' name='[usr:Calculation_1463217402929165:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='Year' name='[yr:date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0igv0bj0cmyt2n0zse9t31me8uzt].[Action (Name Clean)]'>
            <groupfilter function='level-members' level='[Calculation_1463217077719048]' user:ui-action-filter='[Action1_AB7B79CBE3ED475BA1D1BEB4BF563840]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0igv0bj0cmyt2n0zse9t31me8uzt].[yr:date:ok]' filter-group='3'>
            <groupfilter function='level-members' level='[yr:date:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
