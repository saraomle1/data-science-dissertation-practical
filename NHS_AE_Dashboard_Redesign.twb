              <calculation class='tableau' formula='TRIM([Name])' />
            </column>
            <column caption='Total Emergency Admissions' datatype='real' name='[Calculation_1463217090072586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Emergency Admissions via Type 1 A&amp;E in 4 hours])&#13;&#10;+&#13;&#10;ZN([Emergency Admissions via Type 2 A&amp;E in 4 hours])&#13;&#10;+&#13;&#10;ZN([Emergency Admissions via Type 3 and 4 A&amp;E in 4 hours])' />
            </column>
            <column caption='NHS Overall Admission Rate' datatype='real' name='[Calculation_1463217454280723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM([Calculation_1463217090072586]) }&#13;&#10;/&#13;&#10;{ FIXED : SUM([Total attendances]) }' />
            </column>
            <column caption='Admission Rate vs NHS Average' datatype='real' default-format='p0.00%' name='[Calculation_1463217455312917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    SUM([Calculation_1463217090072586])&#13;&#10;    /&#13;&#10;    SUM([Total attendances])&#13;&#10;)&#13;&#10;-&#13;&#10;MIN([Calculation_1463217454280723])' />
            </column>
            <column caption='Admission Rate Benchmark Status' datatype='string' name='[Calculation_1463217456881686]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1463217455312917] &gt; 0 THEN&#13;&#10;    &quot;Above NHS Average&quot;&#13;&#10;ELSEIF [Calculation_1463217455312917] &lt; 0 THEN&#13;&#10;    &quot;Below NHS Average&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Equal to NHS Average&quot;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Emergency Admissions via Type 1 A&amp;E in 4 hours]' role='measure' type='quantitative' />
            <column datatype='real' name='[Emergency Admissions via Type 2 A&amp;E in 4 hours]' role='measure' type='quantitative' />
            <column datatype='real' name='[Emergency Admissions via Type 3 and 4 A&amp;E in 4 hours]' role='measure' type='quantitative' />
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Total attendances]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1463217077719048]' derivation='None' name='[none:Calculation_1463217077719048:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1463217455312917]' derivation='User' name='[usr:Calculation_1463217455312917:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1463217456881686]' derivation='User' name='[usr:Calculation_1463217456881686:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='Year' name='[yr:date:ok]' pivot='key' type='ordinal' />
