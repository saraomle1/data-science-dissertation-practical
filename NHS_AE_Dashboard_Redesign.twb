      <aliases enabled='yes' />
      <column caption='Year Correct' datatype='integer' name='[Calculation_1463217027747841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([date])' />
      </column>
      <column caption='Month Correct' datatype='string' name='[Calculation_1463217028796418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [date])' />
      </column>
      <column caption='Type 1- 4 Hours Clean' datatype='real' name='[Calculation_1463217042739203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Type 1 Departments - 4 hours to decision] &lt; 0&#13;&#10;THEN NULL&#13;&#10;ELSE [Type 1 Departments - 4 hours to decision]&#13;&#10;END' />
      </column>
      <column caption='4 Hour Performance %' datatype='real' default-format='p0.0%' name='[Calculation_1463217062273029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM([Calculation_1463217042739203])&#13;&#10;    + SUM([Type 2 Departments - 4 hours to decision])&#13;&#10;    + SUM([Type 3 Departments - 4 hours to decision])&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([Total attendances])' />
      </column>
      <column caption='Record Count' datatype='integer' name='[Calculation_1463217066692614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Attendance Difference' datatype='real' name='[Calculation_1463217070383111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total attendances]&#13;&#10;-&#13;&#10;(&#13;&#10;[Type 1 Departments - Major A&amp;E]&#13;&#10;+&#13;&#10;[Type 2 Departments - Single Specialty]&#13;&#10;+&#13;&#10;[Type 3 Departments - Other A&amp;E/Minor Injury Unit]&#13;&#10;)' />
      </column>
      <column caption='Name Clean' datatype='string' name='[Calculation_1463217077719048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM([Name])' />
      </column>
      <column caption='Name Cleaning Check' datatype='string' name='[Calculation_1463217078284297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Name] = [Calculation_1463217077719048]&#13;&#10;THEN &quot;Same&quot;&#13;&#10;ELSE &quot;Changed&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Emergency Admissions' datatype='real' name='[Calculation_1463217090072586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Emergency Admissions via Type 1 A&amp;E in 4 hours])&#13;&#10;+&#13;&#10;ZN([Emergency Admissions via Type 2 A&amp;E in 4 hours])&#13;&#10;+&#13;&#10;ZN([Emergency Admissions via Type 3 and 4 A&amp;E in 4 hours])' />
      </column>
      <column caption='Emergency Admission Rate %' datatype='real' default-format='p0.00%' name='[Calculation_1463217094602763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1463217090072586])&#13;&#10;/&#13;&#10;SUM([Total attendances])' />
      </column>
      <column caption='Average Monthly Attendances' datatype='real' name='[Calculation_1463217095733260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total attendances])&#13;&#10;/&#13;&#10;COUNTD(DATETRUNC(&apos;month&apos;, [date]))' />
      </column>
      <column caption='Avg Monthly Attendances Display' datatype='string' name='[Calculation_1463217402929165]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1463217095733260] &gt;= 1000000 THEN&#13;&#10;    STR(ROUND([Calculation_1463217095733260] / 1000000, 1)) + &quot;M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1463217095733260] &gt;= 1000 THEN&#13;&#10;    STR(ROUND([Calculation_1463217095733260] / 1000, 1)) + &quot;K&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(ROUND([Calculation_1463217095733260], 0))&#13;&#10;END' />
      </column>
      <column caption='Show 2019 YoY' datatype='boolean' name='[Calculation_1463217409814543]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Metric Value' datatype='real' name='[Calculation_1463217444204561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1463217443401744]&#13;&#10;&#13;&#10;WHEN &quot;Total Attendances&quot; THEN [Total attendances]&#13;&#10;&#13;&#10;WHEN &quot;Emergency Admissions&quot; THEN [Calculation_1463217090072586]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='NHS Overall Admission Rate' datatype='real' name='[Calculation_1463217454280723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Calculation_1463217090072586]) }&#13;&#10;/&#13;&#10;{ FIXED : SUM([Total attendances]) }' />
      </column>
      <column caption='Admission Rate vs NHS Average' datatype='real' default-format='p0.00%' name='[Calculation_1463217455312917]' role='measure' type='quantitative'>
